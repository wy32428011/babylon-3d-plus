{
  "name": "zending-3d-editor",
  "productName": "ZENDING 3D EDITOR",
  "version": "0.3.24",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.mjs",
    "demo:stacker:scene": "node scripts/create-stacker-mqtt-demo-scene.mjs",
    "demo:stacker:mqtt": "node scripts/publish-stacker-full-demo.mjs",
    "demo:stacker:mqtt:legacy": "node scripts/simulate-stacker-mqtt.mjs",
    "refresh:model-assets": "node scripts/refresh-model-asset-index.mjs",
    "wait:renderer": "node scripts/wait-for-vite-renderer.mjs",
    "build": "tsc -b && vite build && npm run build:viewer && npm run build:electron",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:yzj:visual": "node scripts/build-yzj-direction-arrow-visual.mjs",
    "typecheck": "tsc -b",
    "test:light-editor": "node --experimental-strip-types --test tests/editor/lightEditor.test.ts",
    "test:auto-patrol": "node --experimental-strip-types --test tests/editor/autoPatrol.test.ts tests/editor/autoPatrolPlayback.test.ts",
    "test:manual-roam": "node --experimental-strip-types --test tests/roam/*.test.ts tests/runtime/manualRoamAvatarAsset.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:telemetry": "node scripts/telemetry-test.mjs",
    "test:model-array": "node scripts/model-array-test.mjs",
    "test:builtin-slot": "node scripts/builtin-slot-test.mjs",
    "smoke:units": "node scripts/smoke-meter-unit-contract.mjs && npm run smoke:cad && npm run smoke:model-measurement && npm run smoke:model-array && npm run smoke:model-parameters",
    "smoke:cad": "node scripts/smoke-cad-geometry-fidelity.mjs && node scripts/smoke-cad-block-instances.mjs && node scripts/smoke-cad-extended-geometry.mjs",
    "smoke:model-measurement": "node scripts/smoke-model-measurement.mjs",
    "smoke:model-array": "node scripts/smoke-model-array.mjs",
    "smoke:model-array-packages": "node scripts/smoke-parametric-model-array-packages.mjs",
    "smoke:model-array-visual": "node scripts/smoke-parametric-model-array-visual.mjs",
    "smoke:hierarchy-clipboard": "node scripts/smoke-hierarchy-clipboard.mjs",
    "test:model-parameters": "node --test tests/editor/modelStringParameters.test.mjs",
    "smoke:model-parameters": "npm run test:model-parameters && node scripts/smoke-model-parameter-meters.mjs",
    "smoke:model-picking": "node scripts/smoke-model-picking.mjs",
    "smoke:selection-highlight": "node scripts/smoke-selection-highlight.mjs",
    "smoke:grid": "node scripts/smoke-editor-ground-grid.mjs",
    "smoke:light-editor": "node scripts/smoke-light-editor.mjs",
    "smoke:auto-patrol": "node scripts/smoke-auto-patrol.mjs",
    "smoke:camera-view": "node scripts/smoke-camera-view.mjs",
    "smoke:shelf-instancing": "node scripts/smoke-shelf-shared-instancing.mjs",
    "smoke:persisted-scene-batching": "node scripts/smoke-persisted-scene-batching.mjs",
    "smoke:scene-capacity": "node scripts/smoke-static-model-instancing-policy.mjs && node scripts/smoke-asset-load-scheduler.mjs && node scripts/smoke-scene-capacity.mjs && npm run smoke:persisted-scene-batching && npm run smoke:editor-performance",
    "smoke:gpu": "npm run build && node scripts/smoke-gpu-acceleration.mjs",
    "smoke:viewer:gpu": "node scripts/smoke-viewer-gpu-contract.mjs",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "smoke:packaged:win": "node scripts/smoke-packaged-windows.mjs",
    "smoke:packaged:gpu": "node scripts/smoke-packaged-gpu.mjs",
    "smoke:installer:gpu": "npm run dist:win && npm run smoke:packaged:gpu",
    "test:data-platform-relink": "node --experimental-strip-types --test tests/dataPlatform/*.test.ts",
    "test:data-platform-skybox": "node --experimental-strip-types --test tests/dataPlatform/preloadProgressGate.test.ts tests/dataPlatform/skyboxContract.test.ts tests/dataPlatform/skyboxLifecycle.test.ts tests/dataPlatform/skyboxIndex.test.ts tests/dataPlatform/skyboxRelink.test.ts tests/digitalTwin/dataPlatformSkyboxSync.test.ts tests/digitalTwin/projectLibraryTabs.test.ts tests/digitalTwin/skyboxSyncController.test.ts",
    "smoke:data-platform-skybox:built": "node scripts/smoke-data-platform-skybox.mjs",
    "smoke:data-platform-skybox": "npm run build && npm run smoke:data-platform-skybox:built",
    "smoke:data-platform": "npm run build && npm run test:data-platform-relink && node scripts/smoke-data-platform-project.mjs && npm run smoke:data-platform-skybox:built",
    "test:digital-twin": "npm run test:digital-twin:unit && npm run test:digital-twin:integration",
    "smoke:editor-performance": "node scripts/smoke-editor-large-scene-performance.mjs && node scripts/smoke-hierarchy-virtualization.mjs",
    "smoke:reimport-performance": "npm run build && node scripts/smoke-real-scene-reimport-performance.mjs",
    "smoke:folder-group-move": "node scripts/smoke-folder-group-move.mjs",
    "smoke:folder-group-runtime": "node scripts/smoke-folder-group-runtime.mjs",
    "smoke:transform-gizmo": "node scripts/smoke-transform-gizmo.mjs",
    "test:digital-twin:unit": "node --experimental-strip-types --test tests/digitalTwin/*.test.ts",
    "test:digital-twin:integration": "npm run build:electron && node scripts/run-digital-twin-publish-integration.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.12.0",
    "@babylonjs/ktx2decoder": "9.12.0",
    "@babylonjs/loaders": "^9.12.0",
    "@linkiez/dxf-renew": "^7.4.5",
    "archiver": "^8.0.0",
    "mqtt": "^5.15.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "unzipper": "^0.12.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "description": "面向工业场景搭建、模型参数化与 MQTT 运行预览的 Babylon.js 桌面编辑器。",
  "build": {
    "appId": "com.babylon3d.editor",
    "protocols": [
      {
        "name": "ZENDING 3D EDITOR 项目深链",
        "schemes": [
          "zending3d"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack-clean-electron-dist.mjs",
    "copyright": "Copyright © 2026 ZENDING 3D EDITOR",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-viewer-template",
        "to": "export-viewer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZENDING-3D-EDITOR-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZENDING 3D EDITOR",
      "uninstallDisplayName": "ZENDING 3D EDITOR",
      "deleteAppDataOnUninstall": false
    }
  }
}
