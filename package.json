  "description": "面向工业场景搭建、模型参数化与 MQTT 运行预览的 Babylon.js 桌面编辑器。",
  "build": {
    "appId": "com.babylon3d.editor",
    "protocols": [
      {
        "name": "ZENDING 3D EDITOR 项目深链",
        "schemes": [
          "zending3d"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack-clean-electron-dist.mjs",
    "copyright": "Copyright © 2026 ZENDING 3D EDITOR",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/builtin-skyboxes",
        "to": "builtin-skyboxes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-viewer-template",
        "to": "export-viewer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/builtin-model-packages",
        "to": "builtin-model-packages",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZENDING-3D-EDITOR-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZENDING 3D EDITOR",
      "uninstallDisplayName": "ZENDING 3D EDITOR",
      "deleteAppDataOnUninstall": false
    }
  }
}
