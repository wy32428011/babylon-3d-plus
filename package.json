  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.12.0",
    "@babylonjs/ktx2decoder": "9.12.0",
    "@babylonjs/loaders": "^9.12.0",
    "@babylonjs/serializers": "9.12.0",
    "@linkiez/dxf-renew": "^7.4.5",
    "archiver": "^8.0.0",
    "fflate": "0.8.2",
    "mqtt": "^5.15.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "unzipper": "^0.12.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "description": "面向工业场景搭建、模型参数化与 MQTT 运行预览的 Babylon.js 桌面编辑器。",
  "build": {
    "appId": "com.babylon3d.editor",
    "protocols": [
      {
        "name": "ZENDING 3D EDITOR 项目深链",
        "schemes": [
          "zending3d"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack-clean-electron-dist.mjs",
    "copyright": "Copyright © 2026 ZENDING 3D EDITOR",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/builtin-skyboxes",
        "to": "builtin-skyboxes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/builtin-skybox-environments",
        "to": "builtin-skybox-environments",
        "filter": ["**/*"]
      },
      {
        "from": "dist-viewer-template",
        "to": "export-viewer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/builtin-model-packages",
        "to": "builtin-model-packages",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZENDING-3D-EDITOR-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZENDING 3D EDITOR",
      "uninstallDisplayName": "ZENDING 3D EDITOR",
      "deleteAppDataOnUninstall": false
    }
  }
}
